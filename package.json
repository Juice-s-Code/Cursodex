{
  "name": "cursodex-mcp",
  "version": "0.2.0",
  "description": "A durable MCP collaboration bridge with named agents and live work activity",
  "type": "module",
  "license": "MIT",
  "bin": {
    "cursodex": "bin/cursodex.mjs"
  },
  "engines": {
    "node": ">=22.13.0 <23 || >=24.0.0 <25"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Juice-s-Code/Cursodex.git"
  },
  "homepage": "https://github.com/Juice-s-Code/Cursodex#readme",
  "bugs": {
    "url": "https://github.com/Juice-s-Code/Cursodex/issues"
  },
  "files": [
    "bin/",
    "src/",
    "cli/",
    "README.md",
    "LICENSE",
    "docs/",
    "evaluations/",
    "CHANGELOG.md",
    "SECURITY.md",
    "CONTRIBUTING.md",
    "skills/",
    ".codex-plugin/",
    "evals/",
    "Dockerfile",
    "compose.yaml",
    ".dockerignore",
    "npm-shrinkwrap.json",
    ".env.example",
    "scripts/"
  ],
  "scripts": {
    "start": "node src/index.js",
    "test": "node --test --test-concurrency=1 test/*.test.js",
    "verify:package": "node scripts/verify-package.mjs",
    "verify:container": "node scripts/verify-container.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "zod": "4.6.6",
    "smol-toml": "1.9.1"
  }
}
