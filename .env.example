# Generate separate random values: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# Keep .env private and outside version control. Do not reuse a model/API account key.
CURSODEX_CODEX_TOKEN=
CURSODEX_CURSOR_TOKEN=
# Exact DNS names only, no scheme/port/wildcards. Add your public reverse-proxy hostname.
CURSODEX_ALLOWED_HOSTS=localhost,127.0.0.1
# Optional complete browser origins for an explicitly authorized browser client.
CURSODEX_ALLOWED_ORIGINS=
